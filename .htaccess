# Fuerza HTTPS en todo el sitio
RewriteEngine On

# Si no está usando HTTPS, redirige automáticamente
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Opcional: asegúrate de que Passenger use WSGI
PassengerEnabled on
PassengerAppRoot /home/hipespxt/myflaskapp
PassengerPython /home/hipespxt/virtualenv/myflaskapp/3.11/bin/python
PassengerAppType wsgi
PassengerStartupFile wsgi.py
